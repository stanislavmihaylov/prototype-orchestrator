# Directory where runtime data (runs, interactions, responses, logs) is stored.
# Relative paths resolve from prototype-orchestrator/ (the process working directory).
# Set to ../orchestrator_logs to store data in the main project root (recommended).
PIPELINE_DATA_DIR=../orchestrator_logs

# Set to false when the project has no Figma design (e.g. proposal-based projects).
# When false: Figma MCP check is skipped and design-analyst-flow is not run in the pipeline.
HAS_DESIGN=true

# Set to true to skip the environment-checker step entirely (e.g. in CI or pre-validated envs).
SKIP_ENV_CHECK=false

# Pipeline notification channels — all are optional.
# Any channel without config is silently skipped.

# Slack
SLACK_WEBHOOK_URL=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Email (any SMTP — use smtp.office365.com for Office 365)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
