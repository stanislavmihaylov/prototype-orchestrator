# Directory where runtime data (runs, interactions, responses, logs) is stored.
# Relative paths are resolved from the process working directory (orchestrator/).
# Default: orchestrator/ itself. Override to store data in the main project.
PIPELINE_DATA_DIR=../orchestrator_logs

# Set to false when the project has no Figma design (e.g. proposal-based projects).
# When false: Figma MCP check is skipped and design-analyst-flow is not run in the pipeline.
HAS_DESIGN=false

# Set to true to skip the environment-checker step entirely (e.g. in CI or pre-validated envs).
SKIP_ENV_CHECK=false

# Figma — required when HAS_DESIGN=true
FIGMA_FILE_KEY=RiSFM3ZUS46Jitu9b2jl3r

# Set to true to suppress all notifications (console, Slack, Teams, email)
NOTIFICATIONS_DISABLED=true

# Pipeline notification channels — all are optional.
# Any channel without config is silently skipped.

# Slack
SLACK_WEBHOOK_URL=

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://defaultcbede638a3d9459f8f4e24ced73b4e.5e.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/1891bf48f9b74cdd81a100f58f994b29/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=Ic1vb1loZnLVavsmGRwpfwoYxaX6ZSkBbJ81Dy2FgJ4

# Email (any SMTP — use smtp.office365.com for Office 365)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=stanislav.mihaylov@mentormate.com
NOTIFY_EMAIL_FROM=stanislav
